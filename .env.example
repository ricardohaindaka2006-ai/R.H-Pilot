# Example names only. Copy to an ignored .env.local and fill privately.
# Run locally with: node --env-file=.env.local server.js
# Never paste a password, token, DATABASE_URL or encryption key into chat/source.
# Rotate every previously exposed password/broker credential; do not reuse it.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
ADMIN_EMAIL=ricardohaindaka2006@gmail.com
ADMIN_PASSWORD=
# Required for persistent production customer state/MT5 demo arming on Render.
# Direct/session PostgreSQL only. Remote TLS certificate verification is enforced.
DATABASE_URL=
STATE_NAMESPACE=r-h-pilot
# ONE-TIME, confirmed empty DB initialization/migration only; remove afterward.
# INITIALIZE_EMPTY_DATABASE=1
# Stable random 32-byte AES key (64 hex, base64/base64url); private recovery copy.
DERIV_TOKEN_ENCRYPTION_KEY=
PUBLIC_URL=https://r-h-pilot-3.onrender.com
# Optional Options-wallet registrations, separate from MT5 terminal pairing:
DERIV_PAT_APP_ID=
DERIV_OAUTH_CLIENT_ID=
# DERIV_APP_ID=   # compatibility fallback only
GOOGLE_CLIENT_ID=
# Windows agent configuration is local to that computer; see MT5-FREE-SETUP.md.
# Never configure a terminal password or Windows SDK on the Render service.
